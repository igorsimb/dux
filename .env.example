# Development-only default. Replace this with a unique secret in deployments.
DJANGO_SECRET_KEY=django-insecure-dux-local-development-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PROXY=

# Optional. Defaults to the bundled repository-root Chinook.db file.
CHINOOK_DATABASE_PATH=

CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
